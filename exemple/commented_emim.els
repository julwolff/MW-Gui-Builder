# ============================================================
# EMIM MOLECULE DEFINITION
# ============================================================
#
# This file defines the electrostatic and intramolecular
# force-field parameters associated with emim.xyz.
#
# IMPORTANT:
# The atom ordering must be identical to emim.xyz.
# Atom indices are ZERO-BASED:
#
#   0  N
#   1  C
#   2  N
#   3  C
#   4  C
#   5  H
#   6  H
#   7  H
#   8  C
#   9  H
#  10  H
#  11  H
#  12  C
#  13  C
#  14  H
#  15  H
#  16  H
#  17  H
#  18  H
#
# If the atom order in the XYZ file is changed, all corresponding
# definitions and atom indices in this file must be updated.
# ============================================================


# ------------------------------------------------------------
# ELECTROSTATIC / NON-BONDED ATOM PARAMETERS
# ------------------------------------------------------------
#
# General format:
#
#   atom_type  electrostatic_model  charge  parameter_1  parameter_2
#
# The atom types below correspond, in order, to atoms 0-18
# in emim.xyz.
#
# The partial charges are assigned to the individual atoms.
# Their sum should reproduce the intended total molecular charge.
#
# The remaining parameters are the non-bonded parameters used
# by the corresponding MetalWalls force-field description.
# ------------------------------------------------------------

RN1 point 0.15 0.71128 3.25       # atom 0: N
RC2 point -0.11 0.293 3.55       # atom 1: C
RN3 point 0.15 0.71128 3.25      # atom 2: N
RC4 point -0.13 0.29287999999999997 3.5499999999999998  # atom 3: C
RC5 point -0.13 0.29287999999999997 3.5499999999999998  # atom 4: C
RH2 point 0.21 0.12551999999999999 2.4199999999999999   # atom 5: H
RH4 point 0.21 0.12551999999999999 2.4199999999999999   # atom 6: H
RH5 point 0.21 0.12551999999999999 2.4199999999999999   # atom 7: H
MC8 point -0.17 0.27614000000000000 3.5000000000000000  # atom 8: C
H8A point 0.13 0.12551999999999999 2.5000000000000000   # atom 9: H
H8B point 0.13 0.12551999999999999 2.5000000000000000   # atom 10: H
H8C point 0.13 0.12551999999999999 2.5000000000000000   # atom 11: H
EC6 point -0.17 0.27614000000000000 3.5000000000000000  # atom 12: C
EC7 point -0.05 0.27614000000000000 3.5000000000000000  # atom 13: C
H6A point 0.13 0.12551999999999999 2.5000000000000000   # atom 14: H
H6B point 0.13 0.12551999999999999 2.5000000000000000   # atom 15: H
H7A point 0.06 0.12551999999999999 2.5000000000000000   # atom 16: H
H7B point 0.06 0.12551999999999999 2.5000000000000000   # atom 17: H
H7C point 0.06 0.12551999999999999 2.5000000000000000   # atom 18: H


# ============================================================
# INTRAMOLECULAR INTERACTIONS
# ============================================================

PARAMETERS

# ------------------------------------------------------------
# HARMONIC BONDS
# ------------------------------------------------------------
#
# Format:
#
#   harmonic_bond  atom_i  atom_j  force_constant  equilibrium_distance
#
# Atom indices refer to the atoms in emim.xyz.
# ------------------------------------------------------------

harmonic_bond 1  0   2.1288783227002883E-01  2.4849898647446209E+00
harmonic_bond 1  2   2.1288783227002883E-01  2.4849898647446209E+00
harmonic_bond 4  0   1.9059647107542160E-01  2.6040426111164163E+00
harmonic_bond 3  2   1.9059647107542160E-01  2.6040426111164163E+00
harmonic_bond 3  4   2.3208613377734605E-01  2.5341227441996472E+00
harmonic_bond 2  8   1.5038669514065162E-01  2.7703385108103529E+00
harmonic_bond 0  12  1.5038669514065162E-01  2.7703385108103529E+00
harmonic_bond 12 13  1.1956275549834784E-01  2.8893912571821483E+00


# ------------------------------------------------------------
# CONSTRAINTS
# ------------------------------------------------------------
#
# Format:
#
#   constraint  atom_i  atom_j  fixed_distance
#
# These constraints fix selected bond lengths instead of using
# a harmonic bond potential.
# ------------------------------------------------------------

constraint 1  5     2.0409042235164945E+00
constraint 3  6     2.0409042235164945E+00
constraint 4  7     2.0409042235164945E+00
constraint 8  9     2.0598014848453507E+00
constraint 8 10     2.0598014848453507E+00
constraint 8 11     2.0598014848453507E+00
constraint 12 14     2.0598014848453507E+00
constraint 12 15     2.0598014848453507E+00
constraint 13 16     2.0598014848453507E+00
constraint 13 17     2.0598014848453507E+00
constraint 13 18     2.0598014848453507E+00


# ------------------------------------------------------------
# HARMONIC ANGLES
# ------------------------------------------------------------
#
# Format:
#
#   harmonic_angle  atom_i  atom_j  atom_k  force_constant  equilibrium_angle
#
# The middle atom (atom_j) is the central atom of the angle.
#
# The equilibrium angle is given in radians.
# ------------------------------------------------------------

